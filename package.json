{
  "name": "gp-ui-monorepo",
  "version": "0.4.1",
  "description": "gp-ui - Complete Enterprise Angular UI Component Framework",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run build:demo:css && ng serve gp-ui-demo",
    "dev": "npm run build:demo:css && ng serve gp-ui-demo",
    "build": "node tools/build-all.js",
    "build:lib": "ng build gp-ui",
    "build:blocks": "ng build gp-blocks",
    "build:grid": "npx ng-packagr -p packages/gp-grid/ng-package.json -c packages/gp-grid/tsconfig.lib.prod.json",
    "build:theme": "node tools/build-theme.js",
    "build:icons": "node tools/build-icons.js",
    "build:demo:css": "node tools/build-css.js && node packages/gp-css/bin/gp-css.js build --minify",
    "build:demo": "npm run build:demo:css && ng build gp-ui-demo",
    "test": "node tools/run-tests.js",
    "test:consumer": "node tools/validate-consumer.js",
    "generate": "node tools/generate-component.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node tools/lint.js",
    "package": "node tools/package-release.js",
    "release": "node tools/release.js",
    "publish:all": "powershell -ExecutionPolicy Bypass -File ./publish-all.ps1",
    "publish:dry-run": "powershell -ExecutionPolicy Bypass -File ./publish-all.ps1 -DryRun"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generated-pixel/gp-ui.git"
  },
  "keywords": [
    "angular",
    "components",
    "ui-framework",
    "design-system",
    "accessibility",
    "theming",
    "gp-ui"
  ],
  "author": "Generated Pixel",
  "contributors": [
    {
      "name": "Graeme Gorman",
      "email": "graeme@generatedpixel.dev"
    }
  ],
  "homepage": "https://gp-ui.com/",
  "license": "MIT",
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "jasmine-core": "^7.0.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "zone.js": "^0.16.2"
  },
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "firebase": "^12.18.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.0"
  }
}
