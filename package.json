{
  "name": "gp-analytics-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "npm run build:css && ng serve demo",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "ng build gp-analytics",
    "build:css": "gp-css build",
    "build:demo": "npm run build:css && ng build demo",
