    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@generatedpixel/gp-css": "^1.0.3",
    "@generatedpixel/gp-grid": "^1.0.3",
    "@generatedpixel/gp-rules": "^1.0.3",
    "@generatedpixel/gp-ui": "^1.0.3",
    "@generatedpixel/gp-ui-icons": "^1.0.3",
    "@generatedpixel/gp-ui-theme": "^1.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
