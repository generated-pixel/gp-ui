{
  "name": "gp-analytics",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "ng:serve": "ng serve",
    "start": "npm-run-all -p build:watch lib:watch",
    "build": "ng build",
    "build:watch": "ng build demo --watch --aot --configuration=development",
    "build:serve": "ng serve demo",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "lib:build": "ng build gp-analytics --configuration=production",
    "lib:watch": "ng build gp-analytics --watch --configuration=development"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "angular-eslint": "19.0.2",
    "eslint": "^9.13.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.10.0",
    "vitest": "^4.0.8"
  }
}
