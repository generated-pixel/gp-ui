{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "apps",
  "projects": {
    "gp-analytics": {
      "projectType": "library",
      "root": "packages/gp-analytics",
      "sourceRoot": "packages/gp-analytics/src",
      "prefix": "gp",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "packages/gp-analytics/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "packages/gp-analytics/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "packages/gp-analytics/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "packages/gp-analytics/tsconfig.spec.json"
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/demo",
      "sourceRoot": "apps/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/demo",
            "index": "apps/demo/src/index.html",
            "browser": "apps/demo/src/main.ts",
            "tsConfig": "apps/demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/demo/public"
              }
            ],
            "styles": [
              "node_modules/@generatedpixel/gp-ui-theme/src/index.css",
              "node_modules/@generatedpixel/gp-ui-theme/src/themes/all.css",
              "apps/demo/src/gp-css-generated.css",
              "apps/demo/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "25kB",
                  "maximumError": "50kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/demo/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
